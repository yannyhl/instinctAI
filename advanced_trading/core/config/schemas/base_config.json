{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instinct AI Base Configuration",
  "description": "Base configuration schema for the Instinct AI trading platform",
  "type": "object",
  "properties": {
    "system": {
      "type": "object",
      "description": "System-wide configuration",
      "properties": {
        "environment": {
          "type": "string",
          "description": "Execution environment",
          "enum": ["development", "testing", "production"]
        },
        "log_level": {
          "type": "string",
          "description": "Default logging level",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "timezone": {
          "type": "string",
          "description": "System timezone",
          "default": "UTC"
        }
      },
      "required": ["environment", "log_level"]
    },
    "database": {
      "type": "object",
      "description": "Database configuration",
      "properties": {
        "host": {
          "type": "string",
          "description": "Database host"
        },
        "port": {
          "type": "integer",
          "description": "Database port",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "description": "Database name"
        },
        "user": {
          "type": "string",
          "description": "Database user"
        },
        "password": {
          "type": "string",
          "description": "Database password"
        },
        "connection_pool": {
          "type": "integer",
          "description": "Connection pool size",
          "minimum": 1,
          "default": 5
        }
      },
      "required": ["host", "port", "name", "user", "password"]
    },
    "exchanges": {
      "type": "object",
      "description": "Exchange configuration",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "API key for the exchange"
            },
            "api_secret": {
              "type": "string",
              "description": "API secret for the exchange"
            },
            "testnet": {
              "type": "boolean",
              "description": "Whether to use testnet",
              "default": false
            },
            "rate_limit": {
              "type": "object",
              "description": "Rate limiting configuration",
              "properties": {
                "max_requests": {
                  "type": "integer",
                  "description": "Maximum number of requests",
                  "minimum": 1
                },
                "time_window": {
                  "type": "integer",
                  "description": "Time window in seconds",
                  "minimum": 1
                }
              },
              "required": ["max_requests", "time_window"]
            }
          },
          "required": ["api_key", "api_secret"]
        }
      }
    },
    "strategies": {
      "type": "object",
      "description": "Strategy configuration",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether the strategy is enabled",
              "default": false
            },
            "parameters": {
              "type": "object",
              "description": "Strategy-specific parameters"
            },
            "risk_limits": {
              "type": "object",
              "description": "Risk limits for the strategy",
              "properties": {
                "max_position_size": {
                  "type": "number",
                  "description": "Maximum position size",
                  "minimum": 0
                },
                "max_drawdown": {
                  "type": "number",
                  "description": "Maximum drawdown percentage",
                  "minimum": 0,
                  "maximum": 100
                },
                "max_daily_loss": {
                  "type": "number",
                  "description": "Maximum daily loss percentage",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          },
          "required": ["enabled", "parameters"]
        }
      }
    },
    "risk": {
      "type": "object",
      "description": "Risk management configuration",
      "properties": {
        "global_limits": {
          "type": "object",
          "description": "Global risk limits",
          "properties": {
            "max_portfolio_value": {
              "type": "number",
              "description": "Maximum portfolio value",
              "minimum": 0
            },
            "max_drawdown": {
              "type": "number",
              "description": "Maximum drawdown percentage",
              "minimum": 0,
              "maximum": 100
            },
            "max_daily_loss": {
              "type": "number",
              "description": "Maximum daily loss percentage",
              "minimum": 0,
              "maximum": 100
            },
            "max_leverage": {
              "type": "number",
              "description": "Maximum leverage",
              "minimum": 1
            }
          },
          "required": ["max_drawdown", "max_daily_loss"]
        },
        "circuit_breakers": {
          "type": "object",
          "description": "Circuit breaker configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether circuit breakers are enabled",
              "default": true
            },
            "volatility_threshold": {
              "type": "number",
              "description": "Volatility threshold for circuit breaker",
              "minimum": 0
            },
            "drawdown_threshold": {
              "type": "number",
              "description": "Drawdown threshold for circuit breaker",
              "minimum": 0,
              "maximum": 100
            },
            "volume_threshold": {
              "type": "number",
              "description": "Volume threshold for circuit breaker",
              "minimum": 0
            }
          },
          "required": ["enabled"]
        }
      },
      "required": ["global_limits"]
    },
    "execution": {
      "type": "object",
      "description": "Execution configuration",
      "properties": {
        "default_exchange": {
          "type": "string",
          "description": "Default exchange for execution"
        },
        "slippage_model": {
          "type": "string",
          "description": "Slippage model to use",
          "enum": ["fixed", "percentage", "market_impact"]
        },
        "default_order_type": {
          "type": "string",
          "description": "Default order type",
          "enum": ["market", "limit", "stop", "stop_limit"]
        },
        "retry_attempts": {
          "type": "integer",
          "description": "Number of retry attempts for failed orders",
          "minimum": 0,
          "default": 3
        },
        "retry_delay": {
          "type": "integer",
          "description": "Delay between retry attempts in milliseconds",
          "minimum": 0,
          "default": 1000
        }
      },
      "required": ["default_exchange", "default_order_type"]
    }
  },
  "required": ["system"]
} 