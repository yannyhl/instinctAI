           confidence = None
           if with_confidence and hasattr(regression_model, "predict_proba"):
               confidence = regression_model.predict_proba([features])[0]
           
           # Get current spread for reference
           current_spread = self._get_current_spread_bps(exchange, symbol)
           
           return {
               "exchange": exchange,
               "symbol": symbol,
               "current_spread_bps": current_spread,
               "predicted_spread_bps": predicted_spread,
               "predicted_direction": "widen" if predicted_direction > 0 else "tighten" if predicted_direction < 0 else "stable",
               "prediction_horizon_minutes": horizon,
               "confidence": confidence,
               "timestamp": time.time()
           }
       
       def find_arbitrage_opportunities(self, min_spread_diff_bps=5.0):
           """
           Find cross-exchange spread arbitrage opportunities.
           
           Args:
               min_spread_diff_bps: Minimum spread difference in basis points
               
           Returns:
               List of arbitrage opportunities
           """
           opportunities = []
           exchanges = self.config["monitored_exchanges"]
           symbols = self.market_data.get_common_symbols(exchanges)
           
           for symbol in symbols:
               # Get current spreads for all exchanges
               exchange_spreads = {}
               for exchange in exchanges:
                   spread = self._get_current_spread_bps(exchange, symbol)
                   if spread is not None:
                       exchange_spreads[exchange] = spread
               
               if len(exchange_spreads) < 2:
                   continue
               
               # Find exchanges with tightest and widest spreads
               tightest_exchange = min(exchange_spreads.items(), key=lambda x: x[1])
               widest_exchange = max(exchange_spreads.items(), key=lambda x: x[1])
               
               spread_diff = widest_exchange[1] - tightest_exchange[1]
               
               # Check if difference exceeds threshold
               if spread_diff >= min_spread_diff_bps:
                   opportunity = {
                       "symbol": symbol,
                       "tight_spread_exchange": tightest_exchange[0],
                       "wide_spread_exchange": widest_exchange[0],
                       "tight_spread_bps": tightest_exchange[1],
                       "wide_spread_bps": widest_exchange[1],
                       "spread_difference_bps": spread_diff,
                       "timestamp": time.time()
                   }
                   
                   # Add market making opportunity details
                   opportunity.update(self._calculate_market_making_potential(
                       symbol, tightest_exchange[0], widest_exchange[0]))
                   
                   opportunities.append(opportunity)
           
           # Sort by spread difference
           opportunities.sort(key=lambda x: x["spread_difference_bps"], reverse=True)
           
           return opportunities
       
       def _calculate_market_making_potential(self, symbol, tight_exchange, wide_exchange):
           """Calculate market making potential between two exchanges."""
           # Get current order books
           tight_book = self.market_data.get_orderbook(tight_exchange, symbol)
           wide_book = self.market_data.get_orderbook(wide_exchange, symbol)
           
           if not tight_book or not wide_book:
               return {"market_making_potential": "unknown"}
           
           # Get best prices
           tight_bid = tight_book["bids"][0][0] if tight_book["bids"] else None
           tight_ask = tight_book["asks"][0][0] if tight_book["asks"] else None
           wide_bid = wide_book["bids"][0][0] if wide_book["bids"] else None
           wide_ask = wide_book["asks"][0][0] if wide_book["asks"] else None
           
           if tight_bid is None or tight_ask is None or wide_bid is None or wide_ask is None:
               return {"market_making_potential": "unknown"}
           
           # Calculate cross-exchange market making potential
           cross_bid_ask_diff = wide_bid - tight_ask  # Can buy on tight, sell on wide
           cross_ask_bid_diff = tight_bid - wide_ask  # Can buy on wide, sell on tight
           
           mid_price = (tight_bid + tight_ask + wide_bid + wide_ask) / 4
           
           # Convert to basis points
           cross_bid_ask_bps = (cross_bid_ask_diff / mid_price) * 10000
           cross_ask_bid_bps = (cross_ask_bid_diff / mid_price) * 10000
           
           # Determine potential
           potential = "none"
           direction = "none"
           profit_bps = 0
           
           if cross_bid_ask_bps > 0:
               potential = "immediate"
               direction = "buy_tight_sell_wide"
               profit_bps = cross_bid_ask_bps
           elif cross_ask_bid_bps > 0:
               potential = "immediate"
               direction = "buy_wide_sell_tight"
               profit_bps = cross_ask_bid_bps
           else:
               # No immediate opportunity, check for market making potential
               tight_spread_bps = ((tight_ask - tight_bid) / ((tight_ask + tight_bid) / 2)) * 10000
               wide_spread_bps = ((wide_ask - wide_bid) / ((wide_ask + wide_bid) / 2)) * 10000
               
               if wide_spread_bps - tight_spread_bps > self.config["opportunity_thresholds"]["market_making_min_bps"]:
                   potential = "market_making"
                   direction = "provide_on_wide"
                   profit_bps = wide_spread_bps - tight_spread_bps
           
           return {
               "market_making_potential": potential,
               "trading_direction": direction,
               "profit_potential_bps": profit_bps,
               "tight_exchange_bid": tight_bid,
               "tight_exchange_ask": tight_ask,
               "wide_exchange_bid": wide_bid,
               "wide_exchange_ask": wide_ask
           }
       
       def _get_current_spread_bps(self, exchange, symbol):
           """Get current spread in basis points for a symbol on an exchange."""
           if (exchange not in self.spread_history or
               symbol not in self.spread_history[exchange] or
               not self.spread_history[exchange][symbol]["recent_spreads"]):
               return None
               
           return self.spread_history[exchange][symbol]["recent_spreads"][-1]["spread_bps"]
       
       def update_exchange_profiles(self):
           """Update exchange spread profiles with the latest data."""
           exchanges = self.config["monitored_exchanges"]
           symbols = self.market_data.get_common_symbols(exchanges)
           
           for exchange in exchanges:
               for symbol in symbols:
                   history = self.spread_history[exchange][symbol]["recent_spreads"]
                   
                   if len(history) < 100:  # Need sufficient history
                       continue
                   
                   # Extract spread values
                   spreads = [entry["spread_bps"] for entry in history]
                   
                   # Calculate basic statistics
                   mean_spread = statistics.mean(spreads)
                   spread_std = statistics.stdev(spreads)
                   
                   # Update profile
                   self.spread_profiles[exchange][symbol]["typical_spread_bps"] = mean_spread
                   self.spread_profiles[exchange][symbol]["spread_volatility"] = spread_std
                   
                   # Set anomaly thresholds
                   threshold = self.config["opportunity_thresholds"]["abnormal_spread_z_score"]
                   self.spread_profiles[exchange][symbol]["anomaly_thresholds"]["tight"] = mean_spread - (threshold * spread_std)
                   self.spread_profiles[exchange][symbol]["anomaly_thresholds"]["wide"] = mean_spread + (threshold * spread_std)
                   
                   # Update time patterns if configured
                   if self.config["time_factors"]["use_time_of_day"]:
                       self._update_time_patterns(exchange, symbol, history)
                   
                   # Update market condition impact if configured
                   if any(self.config["market_factors"].values()):
                       self._update_market_condition_impact(exchange, symbol, history)
                   
                   # Mark as updated
                   self.spread_profiles[exchange][symbol]["last_updated"] = time.time()
       
       def get_exchange_spread_profile(self, exchange, symbol):
           """Get the current spread profile for a specific exchange and symbol."""
           if (exchange not in self.spread_profiles or
               symbol not in self.spread_profiles[exchange]):
               return None
               
           return self.spread_profiles[exchange][symbol]
       
       def get_spread_visualization_data(self, exchange, symbol, time_period="day"):
           """Get data for visualizing spread behavior."""
           if (exchange not in self.spread_history or
               symbol not in self.spread_history[exchange]):
               return None
               
           history = self.spread_history[exchange][symbol]["recent_spreads"]
           
           # Filter by time period
           current_time = time.time()
           if time_period == "hour":
               cutoff = current_time - (60 * 60)
           elif time_period == "day":
               cutoff = current_time - (24 * 60 * 60)
           elif time_period == "week":
               cutoff = current_time - (7 * 24 * 60 * 60)
           else:
               cutoff = 0
               
           filtered_history = [entry for entry in history if entry["timestamp"] >= cutoff]
           
           if not filtered_history:
               return None
               
           # Extract data points
           data = {
               "timestamps": [entry["timestamp"] for entry in filtered_history],
               "spreads": [entry["spread_bps"] for entry in filtered_history],
               "mid_prices": [entry["mid_price"] for entry in filtered_history],
               "anomalies": []
           }
           
           # Add anomalies if any
           anomalies = self.spread_history[exchange][symbol]["anomalies"]
           if anomalies:
               anomalies_in_period = [a for a in anomalies if a["timestamp"] >= cutoff]
               data["anomalies"] = [{
                   "timestamp": a["timestamp"],
                   "spread_bps": a["spread_bps"],
                   "type": a["type"],
                   "z_score": a["z_score"]
               } for a in anomalies_in_period]
           
           # Add profile for reference
           data["profile"] = self.get_exchange_spread_profile(exchange, symbol)
           
           return data
