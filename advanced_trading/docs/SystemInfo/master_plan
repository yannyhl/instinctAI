           # Get depth at different levels
           closest_depth = depth.get(0.1, 0)
           if closest_depth >= size:
               # Enough liquidity at closest level
               return 0.05  # 5 basis points
               
           # Need to go into deeper levels
           remaining_size = size - closest_depth
           for level in [0.2, 0.5, 1.0, 2.0]:
               level_depth = depth.get(level, 0) - depth.get(level/2, 0)  # Additional depth at this level
               if level_depth >= remaining_size:
                   # Found enough liquidity at this level
                   return level * 0.5  # Impact is half the level percentage
               remaining_size -= level_depth
               
           # Not enough liquidity in visible book
