       def _update_book_pressure(self, symbol, book_data):
           """Calculate metrics of buying/selling pressure."""
           if symbol not in self.book_pressure_metrics:
               self.book_pressure_metrics[symbol] = {}
               
           bids = book_data.get('bids', [])
           asks = book_data.get('asks', [])
           
           if not bids or not asks:
               return
               
           # Basic spread metrics
           spread = asks[0][0] - bids[0][0]
           mid_price = (asks[0][0] + bids[0][0]) / 2
           spread_bps = (spread / mid_price) * 10000  # in basis points
           
           # Calculate depth at different levels
           depth_levels = [0.1, 0.2, 0.5, 1.0, 2.0]  # percent from mid price
           bid_depth = {level: 0 for level in depth_levels}
           ask_depth = {level: 0 for level in depth_levels}
           
           for bid in bids:
               price_delta_pct = (mid_price - bid[0]) / mid_price * 100
               for level in depth_levels:
                   if price_delta_pct <= level:
                       bid_depth[level] += bid[1]
                       
           for ask in asks:
               price_delta_pct = (ask[0] - mid_price) / mid_price * 100
               for level in depth_levels:
                   if price_delta_pct <= level:
                       ask_depth[level] += ask[1]
           
           # Calculate depth imbalance at each level
           depth_imbalance = {}
           for level in depth_levels:
               total_depth = bid_depth[level] + ask_depth[level]
               if total_depth > 0:
                   depth_imbalance[level] = (bid_depth[level] - ask_depth[level]) / total_depth
               else:
                   depth_imbalance[level] = 0
                   
           # Update metrics dictionary
           self.book_pressure_metrics[symbol].update({
               'spread': spread,
               'spread_bps': spread_bps,
               'bid_depth': bid_depth,
               'ask_depth': ask_depth,
               'depth_imbalance': depth_imbalance,
               'timestamp_us': book_data.get('timestamp_us', time.time() * 1000000)
           })
           
       def _predict_short_term_moves(self, symbol):
           """Predict price movement in next few seconds."""
           if (symbol not in self.current_imbalance or 
               symbol not in self.book_pressure_metrics):
               return {'direction': 'neutral', 'confidence': 0, 'horizon_ms': 1000}
               
           imbalance = self.current_imbalance[symbol]
           pressure = self.book_pressure_metrics[symbol]
           
           # Combine signals
           signals = []
           
           # Imbalance signal
           imb_signal = imbalance['weighted_imbalance']
           signals.append(imb_signal)
           
           # Depth imbalance signals
           depth_signal = 0
           for level, imb in pressure['depth_imbalance'].items():
               # Give more weight to closer levels
               level_weight = 1.0 / float(level)
               depth_signal += imb * level_weight
           depth_signal /= sum(1.0 / float(level) for level in pressure['depth_imbalance'])
           signals.append(depth_signal)
           
           # Additional signals from pattern recognizer
           pattern_signals = self.pattern_recognizer.get_directional_signals(symbol)
           signals.extend(pattern_signals)
           
           # Combine signals with weights
           weights = [0.4, 0.3] + [0.3 / len(pattern_signals)] * len(pattern_signals) if pattern_signals else [0.5, 0.5]
           combined_signal = sum(s * w for s, w in zip(signals, weights))
           
           # Convert to direction and confidence
           confidence = min(abs(combined_signal) * 2, 1.0)  # Scale to 0-1
           
           if combined_signal > 0.05:
               direction = "up"
           elif combined_signal < -0.05:
               direction = "down"
           else:
               direction = "neutral"
               confidence = min(confidence, 0.3)  # Cap confidence for neutral signals
               
           # Adjust horizon based on confidence
           horizon_ms = int(1000 * (1.0 - confidence * 0.7))  # 300ms to 1000ms
           
           return {
               'direction': direction,
               'confidence': confidence,
               'horizon_ms': horizon_ms,
               'raw_signal': combined_signal
           }
           
