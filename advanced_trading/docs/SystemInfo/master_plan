       def _update_imbalance(self, symbol, book_data):
           """Calculate buy/sell imbalance at various price levels."""
           bids = book_data.get('bids', [])
           asks = book_data.get('asks', [])
           
           if not bids or not asks:
               return
               
           # Calculate visible bid/ask imbalance
           bid_volume = sum(bid[1] for bid in bids)
           ask_volume = sum(ask[1] for ask in asks)
           
           total_volume = bid_volume + ask_volume
           if total_volume > 0:
               bid_ratio = bid_volume / total_volume
               ask_ratio = ask_volume / total_volume
               imbalance = bid_ratio - ask_ratio
           else:
               bid_ratio = ask_ratio = 0.5
               imbalance = 0
               
           # Calculate weighted imbalance (giving more weight to prices closer to mid)
           mid_price = (bids[0][0] + asks[0][0]) / 2
           weighted_bid_volume = sum(bid[1] * (1 - (mid_price - bid[0]) / mid_price * 5) 
                                  for bid in bids)
           weighted_ask_volume = sum(ask[1] * (1 - (ask[0] - mid_price) / mid_price * 5) 
                                  for ask in asks)
           
           weighted_total = weighted_bid_volume + weighted_ask_volume
           if weighted_total > 0:
               weighted_imbalance = (weighted_bid_volume - weighted_ask_volume) / weighted_total
           else:
               weighted_imbalance = 0
               
