           self.anomaly_detector = AnomalyDetector()
           self.exchange_registry = ExchangeRegistry()
           
           # Initialize profiles for monitored exchanges
           self._initialize_exchange_profiles()
       
       def _default_config(self):
           """Default configuration for spread analysis."""
           return {
               "min_spread_bps": 1.0,  # Minimum spread in basis points to consider
               "update_frequency_ms": 500,  # Frequency of spread updates
               "history_window_days": 30,  # Historical data window
               "opportunity_thresholds": {
                   "arbitrage_min_bps": 5.0,  # Minimum bps difference for arbitrage
                   "market_making_min_bps": 3.0,  # Minimum bps for market making
                   "abnormal_spread_z_score": 2.5  # Z-score for abnormal spread
               },
               "time_factors": {
                   "use_time_of_day": True,
                   "use_day_of_week": True,
                   "use_market_hours": True
               },
               "market_factors": {
                   "use_volatility": True,
                   "use_volume": True,
                   "use_order_book_depth": True
               },
               "prediction_horizons": [1, 5, 15, 60],  # minutes
               "monitored_exchanges": ["exchange_a", "exchange_b", "exchange_c"],
               "log_level": "info"
           }
       
       def _initialize_exchange_profiles(self):
           """Initialize spread profiles for all monitored exchanges."""
           exchanges = self.config["monitored_exchanges"]
           symbols = self.market_data.get_common_symbols(exchanges)
           
           for exchange in exchanges:
               self.spread_profiles[exchange] = {}
               self.spread_models[exchange] = {}
               self.spread_history[exchange] = {}
               
               for symbol in symbols:
                   self.spread_profiles[exchange][symbol] = self._create_initial_profile(exchange, symbol)
                   self.spread_models[exchange][symbol] = self._initialize_models(exchange, symbol)
                   self.spread_history[exchange][symbol] = {
                       "recent_spreads": [],  # Recent raw spreads
                       "hourly_stats": {},    # Hourly spread statistics
                       "daily_stats": {},     # Daily spread statistics
                       "anomalies": []        # Detected anomalies
                   }
       
       def _create_initial_profile(self, exchange, symbol):
           """Create initial spread profile for an exchange/symbol pair."""
           # Get exchange capabilities
           capabilities = self.exchange_registry.get_exchange_capabilities(exchange)
           
           # Create basic profile
           return {
               "min_tick_size": capabilities.get("price_precision", 0.01),
               "typical_spread_bps": None,  # Will be populated with data
               "spread_volatility": None,   # Will be populated with data
               "time_patterns": {
                   "hourly": [None] * 24,   # Hourly spread patterns
                   "daily": [None] * 7      # Daily spread patterns
               },
               "market_condition_impact": {
                   "high_volatility": None,
                   "high_volume": None,
                   "low_liquidity": None
               },
               "anomaly_thresholds": {
                   "tight": None,  # Unusually tight spread
                   "wide": None    # Unusually wide spread
               },
               "last_updated": None
           }
       
       def _initialize_models(self, exchange, symbol):
           """Initialize prediction models for spread behavior."""
           models = {}
           for horizon in self.config["prediction_horizons"]:
               models[horizon] = {
                   "regression": None,  # For predicting exact spread
                   "classification": None,  # For predicting spread direction
                   "last_trained": None,
                   "accuracy": {
                       "mae": None,
                       "rmse": None,
                       "direction_accuracy": None
                   }
               }
           return models
       
       def update_spreads(self):
           """
           Update current spreads for all monitored exchanges and symbols.
           This should be called at the frequency specified in config.
           """
           exchanges = self.config["monitored_exchanges"]
           symbols = self.market_data.get_common_symbols(exchanges)
           current_time = time.time()
           
           for exchange in exchanges:
               for symbol in symbols:
                   # Get current orderbook
                   orderbook = self.market_data.get_orderbook(exchange, symbol)
                   if not orderbook:
                       continue
                       
                   # Calculate current spread
                   best_bid = orderbook["bids"][0][0] if orderbook["bids"] else None
                   best_ask = orderbook["asks"][0][0] if orderbook["asks"] else None
                   
                   if best_bid is None or best_ask is None:
                       continue
                       
                   absolute_spread = best_ask - best_bid
                   mid_price = (best_ask + best_bid) / 2
                   spread_bps = (absolute_spread / mid_price) * 10000  # Convert to basis points
                   
                   # Store in history
                   spread_entry = {
                       "timestamp": current_time,
                       "best_bid": best_bid,
                       "best_ask": best_ask,
                       "spread_absolute": absolute_spread,
                       "spread_bps": spread_bps,
                       "mid_price": mid_price
                   }
                   
                   # Add market context
                   spread_entry.update(self._get_market_context(exchange, symbol))
                   
                   # Add to recent history
                   self.spread_history[exchange][symbol]["recent_spreads"].append(spread_entry)
                   
                   # Limit history size
                   max_entries = int((24 * 60 * 60 * 1000) / self.config["update_frequency_ms"])
                   if len(self.spread_history[exchange][symbol]["recent_spreads"]) > max_entries:
                       self.spread_history[exchange][symbol]["recent_spreads"].pop(0)
                   
                   # Check for anomalies
                   self._check_for_anomalies(exchange, symbol, spread_entry)
                   
                   # Update hourly stats if needed
                   self._update_time_based_stats(exchange, symbol, spread_entry)
       
       def _get_market_context(self, exchange, symbol):
           """Get current market context for spread analysis."""
           # Get volatility (e.g., 5-minute realized volatility)
           volatility = self.market_data.get_recent_volatility(exchange, symbol, minutes=5)
           
           # Get recent volume
           volume = self.market_data.get_recent_volume(exchange, symbol, minutes=5)
           
           # Get order book depth
           depth = self.market_data.get_orderbook_depth(exchange, symbol, depth_usd=100000)
           
           # Get current time context
           current_time = time.time()
           hour_of_day = datetime.fromtimestamp(current_time).hour
           day_of_week = datetime.fromtimestamp(current_time).weekday()
           
           return {
               "volatility": volatility,
               "volume": volume,
               "depth": depth,
               "hour_of_day": hour_of_day,
               "day_of_week": day_of_week
           }
       
       def _check_for_anomalies(self, exchange, symbol, spread_entry):
           """Check if current spread represents an anomaly."""
           profile = self.spread_profiles[exchange][symbol]
           
           # Need enough history to detect anomalies
           if profile["typical_spread_bps"] is None:
               return
               
           # Z-score calculation
           z_score = (spread_entry["spread_bps"] - profile["typical_spread_bps"]) / profile["spread_volatility"]
           
           # Anomaly thresholds
           threshold = self.config["opportunity_thresholds"]["abnormal_spread_z_score"]
           
           # Check if anomalous
           is_anomaly = abs(z_score) > threshold
           anomaly_type = None
           
           if is_anomaly:
               anomaly_type = "tight" if z_score < 0 else "wide"
               
               # Log the anomaly
               anomaly = {
                   "timestamp": spread_entry["timestamp"],
                   "exchange": exchange,
                   "symbol": symbol,
                   "spread_bps": spread_entry["spread_bps"],
                   "typical_spread_bps": profile["typical_spread_bps"],
                   "z_score": z_score,
                   "type": anomaly_type,
                   "context": {
                       "volatility": spread_entry["volatility"],
                       "volume": spread_entry["volume"],
                       "hour_of_day": spread_entry["hour_of_day"],
                       "day_of_week": spread_entry["day_of_week"]
                   }
               }
               
               self.spread_history[exchange][symbol]["anomalies"].append(anomaly)
               
               # Limit anomalies history
               if len(self.spread_history[exchange][symbol]["anomalies"]) > 1000:
                   self.spread_history[exchange][symbol]["anomalies"].pop(0)
               
               # Generate trading signal for anomaly if configured
               if self.config["market_factors"]["use_order_book_depth"]:
                   self._generate_anomaly_signal(exchange, symbol, anomaly)
       
