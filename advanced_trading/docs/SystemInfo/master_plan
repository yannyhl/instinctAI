               'ask_volume': ask_volume,
               'bid_ratio': bid_ratio,
               'ask_ratio': ask_ratio,
               'raw_imbalance': imbalance,
               'weighted_imbalance': weighted_imbalance,
               'timestamp_us': book_data.get('timestamp_us', time.time() * 1000000)
